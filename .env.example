# Vision provider: openai, anthropic (Claude) or gemini
GEOAGENT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: faster model and reasoning effort for the per-zoom map placement calls
GEOAGENT_MAP_MODEL=
GEOAGENT_MAP_EFFORT=
# Optional: reasoning effort for the street-scene guess (low is fastest)
GEOAGENT_SCENE_EFFORT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEOAGENT_TIMEOUT_SECONDS=90
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
